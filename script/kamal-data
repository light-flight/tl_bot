#!/usr/bin/env bash
# pull — снять /data/settings.sqlite со старого VPS в data/migration/.
# push — записать эту копию на сервер из config/deploy.production.yml.
#
# Файл читает отдельный контейнер из уже лежащего образа. `kamal app exec`
# для этого не подходит: на Kamal 2.8 он портит бинарный вывод и не работает,
# когда контейнер остановлен.
set -euo pipefail

cd "$(dirname "$0")/.."

service=tl_bot
role=web
destination=production
volume=tl_bot_data
db_name=settings.sqlite
local_dir=data/migration
local_file="${local_dir}/${db_name}"
ssh_user=root
file_owner=1000:1000
ssh_opts=(-o BatchMode=yes -o ConnectTimeout=15 -T)

# Состояние pull живёт в глобальных переменных: EXIT-ловушка срабатывает
# уже после выхода из функции, и локальные переменные к тому моменту сняты.
g_host=""
g_image=""
g_backup_state=""
g_should_restart=0
g_tmp=""
g_ids=()

die() {
  printf '%s\n' "$1" >&2
  exit 1
}

usage() {
  cat >&2 <<'EOF'
usage: script/kamal-data pull <host> [--force]
       script/kamal-data push
EOF
  exit 1
}

valid_host() {
  [[ "$1" =~ ^[A-Za-z0-9][A-Za-z0-9.:-]*$ ]]
}

valid_image() {
  [[ "$1" =~ ^[A-Za-z0-9][A-Za-z0-9_./:@+-]*$ ]]
}

valid_id() {
  [[ "$1" =~ ^[0-9a-f]+$ ]]
}

ssh_sh() {
  local host=$1
  shift
  ssh "${ssh_opts[@]}" "${ssh_user}@${host}" sh -s -- "$@"
}

sqlite_ok() {
  local file=$1 size header
  [ -f "$file" ] || return 1
  size=$(wc -c < "$file" | tr -d '[:space:]')
  [ "$size" -ge 15 ] || return 1
  header=$(dd if="$file" bs=15 count=1 2>/dev/null)
  [ "$header" = "SQLite format 3" ]
}

file_size() {
  wc -c < "$1" | tr -d '[:space:]'
}

file_sha() {
  openssl dgst -sha256 "$1" | awk '{ print $NF }'
}

destination_host() {
  local config host
  if ! config=$(kamal config -d "$destination"); then
    die "kamal config -d ${destination} завершился с ошибкой."
  fi
  host=$(printf '%s\n' "$config" | awk '/^:primary_host:/ { print $2; exit }')
  if [ -z "$host" ]; then
    host=$(printf '%s\n' "$config" | awk '/^primary_host:/ { print $2; exit }')
  fi
  host=${host//$'\r'/}
  host=${host#\"}
  host=${host%\"}
  host=${host#\'}
  host=${host%\'}
  if ! valid_host "$host"; then
    die "Не удалось прочитать primary host из kamal config."
  fi
  printf '%s\n' "$host"
}

# shellcheck disable=SC2029
volume_sh() {
  local host=$1 image=$2 run_flags=$3 mount_mode=$4 script=$5
  local mount="${volume}:/data"
  valid_image "$image" || die "Непонятное имя образа на ${host}."
  case "$script" in
    *\'*) die "Внутренняя ошибка: скрипт volume содержит кавычку." ;;
  esac
  if [ "$mount_mode" = ro ]; then
    mount="${mount}:ro"
  fi
  # run_flags — только фиксированные флаги из этого файла, не ввод пользователя.
  ssh "${ssh_opts[@]}" "${ssh_user}@${host}" \
    "docker run --rm --network none --read-only --tmpfs /tmp ${run_flags} --entrypoint sh -v ${mount} '${image}' -c '${script}'"
}

app_image() {
  local host=$1 image
  image=$(ssh_sh "$host" "$service" "$role" "$destination" <<'EOF'
set -eu
service=$1
role=$2
destination=$3
docker ps -a \
  --filter "label=service=${service}" \
  --filter "label=role=${role}" \
  --filter "label=destination=${destination}" \
  --format '{{.Image}}'
EOF
)
  image=${image%%$'\n'*}
  image=${image//$'\r'/}
  if [ -z "$image" ]; then
    return 1
  fi
  valid_image "$image" || return 1
  printf '%s\n' "$image"
}

remote_state() {
  local host=$1 image=$2 state
  state=$(volume_sh "$host" "$image" "" ro \
    'if [ -e /data/settings.sqlite-journal ]; then echo journal; elif [ ! -s /data/settings.sqlite ]; then echo empty; else echo ok; fi')
  state=${state//$'\r'/}
  printf '%s\n' "${state%%$'\n'*}"
}

cleanup_pull() {
  local status=$?
  if [ "$g_should_restart" -eq 1 ]; then
    if [ "${#g_ids[@]}" -eq 0 ] || ! ssh_sh "$g_host" "${g_ids[@]}" <<'EOF'
set -eu
docker start "$@" >/dev/null
EOF
    then
      printf 'Не удалось снова запустить бота на %s.\n' "$g_host" >&2
      status=1
    else
      printf 'Бот на %s снова запущен.\n' "$g_host"
    fi
    g_should_restart=0
  fi
  if [ -n "$g_tmp" ]; then
    rm -f "$g_tmp"
    g_tmp=""
  fi
  exit "$status"
}

pull() {
  local force=0 end_opts=0 arg image state size hash raw id
  g_host=""
  g_should_restart=0
  g_tmp=""
  g_ids=()

  for arg in "$@"; do
    if [ "$end_opts" -eq 0 ]; then
      case "$arg" in
        --force) force=1; continue ;;
        --) end_opts=1; continue ;;
        -*) die "Неизвестный аргумент: ${arg}" ;;
      esac
    fi
    if [ -n "$g_host" ]; then
      die "Укажите один хост."
    fi
    g_host=$arg
  done

  if [ -z "$g_host" ]; then
    usage
  fi
  if ! valid_host "$g_host"; then
    die "Некорректный хост: ${g_host}"
  fi
  if [ -f "$local_file" ] && [ "$force" -ne 1 ]; then
    die "Файл ${local_file} уже есть. Повторите с --force, чтобы заменить его."
  fi

  trap cleanup_pull EXIT

  raw=$(ssh_sh "$g_host" "$service" "$role" "$destination" <<'EOF'
set -eu
service=$1
role=$2
destination=$3
docker ps -q \
  --filter "label=service=${service}" \
  --filter "label=role=${role}" \
  --filter "label=destination=${destination}"
EOF
)
  while IFS= read -r id; do
    id=${id//$'\r'/}
    [ -z "$id" ] && continue
    valid_id "$id" || die "Непонятный id контейнера на ${g_host}."
    g_ids+=("$id")
  done <<< "$raw"

  if ! image=$(app_image "$g_host"); then
    die "На ${g_host} нет контейнера бота."
  fi

  if [ "${#g_ids[@]}" -gt 0 ]; then
    g_should_restart=1
    ssh_sh "$g_host" "${g_ids[@]}" <<'EOF'
set -eu
docker stop -t 20 "$@" >/dev/null
EOF
  fi

  state=$(remote_state "$g_host" "$image")
  case "$state" in
    ok) ;;
    journal) die "База на ${g_host} не закрылась: остался settings.sqlite-journal." ;;
    empty) die "На ${g_host} нет ${db_name}." ;;
    *) die "Не удалось проверить базу на ${g_host}." ;;
  esac

  mkdir -p "$local_dir"
  chmod 700 "$local_dir"
  umask 077
  g_tmp=$(mktemp "${local_dir}/settings.sqlite.XXXXXX")

  ssh "${ssh_opts[@]}" "${ssh_user}@${g_host}" \
    "docker run --rm --network none --read-only --entrypoint cat -v ${volume}:/data:ro '${image}' /data/${db_name}" \
    < /dev/null > "$g_tmp"

  if ! sqlite_ok "$g_tmp"; then
    die "С ${g_host} пришёл не файл SQLite."
  fi

  size=$(file_size "$g_tmp")
  hash=$(file_sha "$g_tmp")
  mv "$g_tmp" "$local_file"
  g_tmp=""
  chmod 600 "$local_file"

  printf 'Снято с %s: %s\n' "$g_host" "$local_file"
  printf '%s байт\n' "$size"
  printf 'sha256 %s\n' "$hash"
  if [ "${#g_ids[@]}" -eq 0 ]; then
    printf 'Бот на %s не был запущен.\n' "$g_host"
  fi
}

restore_and_start() {
  local message=$1
  if [ "$g_backup_state" = backed-up ]; then
    if ! volume_sh "$g_host" "$g_image" "--user ${file_owner}" rw \
      'set -eu
cp -a /data/settings.sqlite.bak /data/settings.sqlite
chmod 600 /data/settings.sqlite'; then
      die "${message} Не удалось вернуть /data/settings.sqlite.bak. Бот остановлен."
    fi
    message="${message} Предыдущая база восстановлена."
  fi
  if ! kamal app start -d "$destination"; then
    die "${message} Бот не запустился."
  fi
  die "$message"
}

push() {
  local size hash answer backup_state meta remote_size remote_hash
  g_host=""
  g_image=""
  g_backup_state=""

  if [ "$#" -ne 0 ]; then
    usage
  fi
  if [ ! -f "$local_file" ]; then
    die "Нет ${local_file}. Сначала script/kamal-data pull."
  fi
  if ! sqlite_ok "$local_file"; then
    die "${local_file} — не файл SQLite."
  fi

  g_host=$(destination_host)
  size=$(file_size "$local_file")
  hash=$(file_sha "$local_file")
  printf 'Файл %s, %s байт, sha256 %s\n' "$local_file" "$size" "$hash" >&2
  printf 'Записать его на %s вместо базы бота? [y/N] ' "$g_host" >&2
  if ! read -r answer < /dev/tty; then
    die "Отменено."
  fi
  case "$answer" in
    y|Y) ;;
    *) die "Отменено." ;;
  esac

  if ! kamal app stop -d "$destination"; then
    die "Не удалось остановить бота. База на сервере не изменена."
  fi

  if ! g_image=$(app_image "$g_host"); then
    kamal app start -d "$destination" || true
    die "На ${g_host} нет контейнера бота. База не изменена, бот снова запущен."
  fi

  if ! backup_state=$(volume_sh "$g_host" "$g_image" "--user ${file_owner}" rw \
    'set -eu
if [ -f /data/settings.sqlite ]; then
  cp -a /data/settings.sqlite /data/settings.sqlite.bak
  echo backed-up
else
  echo no-previous
fi'); then
    kamal app start -d "$destination" || true
    die "Не удалось сохранить предыдущий файл. База не заменена, бот снова запущен."
  fi
  backup_state=${backup_state//$'\r'/}
  backup_state=${backup_state%%$'\n'*}
  case "$backup_state" in
    backed-up|no-previous) g_backup_state=$backup_state ;;
    *)
      kamal app start -d "$destination" || true
      die "Не удалось сохранить предыдущий файл. База не заменена, бот снова запущен."
      ;;
  esac

  if ! volume_sh "$g_host" "$g_image" "-i --user ${file_owner}" rw \
    'set -eu
rm -f /data/settings.sqlite.tmp
cat > /data/settings.sqlite.tmp
mv /data/settings.sqlite.tmp /data/settings.sqlite
chmod 600 /data/settings.sqlite' < "$local_file"; then
    restore_and_start "Не удалось записать файл."
  fi

  if ! meta=$(volume_sh "$g_host" "$g_image" "" ro \
    'wc -c < /data/settings.sqlite; sha256sum /data/settings.sqlite'); then
    restore_and_start "Не удалось сверить файл."
  fi
  remote_size=$(printf '%s\n' "$meta" | awk 'NR==1 { print $1; exit }')
  remote_hash=$(printf '%s\n' "$meta" | awk 'NR==2 { print $1; exit }')
  remote_size=${remote_size//$'\r'/}
  remote_hash=${remote_hash//$'\r'/}
  if [ "$remote_size" != "$size" ] || [ "$remote_hash" != "$hash" ]; then
    restore_and_start "Контрольная сумма не сошлась."
  fi

  if ! kamal app start -d "$destination"; then
    restore_and_start "Бот не запустился."
  fi

  printf 'База на %s заменена, бот запущен.\n' "$g_host"
  if [ "$g_backup_state" = backed-up ]; then
    printf 'Предыдущий файл: /data/settings.sqlite.bak\n'
  fi
}

case "${1:-}" in
  pull)
    shift
    pull "$@"
    ;;
  push)
    shift
    push "$@"
    ;;
  *)
    usage
    ;;
esac
